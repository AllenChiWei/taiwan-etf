# 機密設定 - 絕不上傳
.env
.env.*
# .env.example 只寫變數名稱不含值，要進版控
!.env.example
*.key
*.pem
secrets.json

# Python 暫存
__pycache__/
*.pyc
.venv/
venv/

# 開發用診斷產物（tools/make_diag.py 產生）
__diag.html

# 加密產物與 manifest 由部署流程產生（本機這份是用測試密碼加密的）。
# us_etfs.json 不在此列：它是公開的衍生統計，見 scripts/encrypt_data.py 的說明。
app/public/data/*.enc
app/public/data/secure.json

# 績效曲線：部署時即時產生，不進版控（每天全部重算，commit 會爆掉）
app/public/data/series/
# 試算用的月頻價格與配息，同樣在部署時產生。345 檔、共 0.4 MB，
# 但每天都會因為最新一個月的價格而全部改動 —— 進版控一年會多出上百 MB。
app/public/data/calc/
# 籌碼是每日快照，部署時重抓（來源是免費的公開端點，不需要憑證）
app/public/data/chips.json

# 抓取資料的中間產物
*.tmp
*.bak
taiwan_etf_list.html.bak

# 作業系統
Thumbs.db
desktop.ini
.DS_Store

# 開發工具的暫存（瀏覽器設定檔等），放專案底下而非系統碟
.cache/
