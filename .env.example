# 複製成 .env 填入你的值。.env 已被 .gitignore 擋掉，不會進版控。
#
#   cp .env.example .env

# FinLab API token。登入 https://ai.finlab.tw/api_token 取得。
# 這是付費訂閱憑證，外洩等於別人可以用你的額度，不要貼到任何對話或 issue。
FINLAB_API_TOKEN=

# 訪客要看美股資料與績效曲線時輸入的密碼（台股清單不受限制）。
# 改這組密碼並重新部署，所有既有的解鎖工作階段都會失效。
SITE_PASSWORD=

# 金鑰導出用的 salt，base64 的 16 bytes。
# 這不是機密 —— 它會隨 data/secure.json 公開給瀏覽器。固定它的理由是：
# 每次部署都換 salt 會讓所有人的工作階段失效，等於每天都要重新輸入密碼。
# 產生方式：python -c "import os,base64;print(base64.b64encode(os.urandom(16)).decode())"
SITE_SALT=

# ---- GitHub Actions 設定 ----
# Settings → Secrets and variables → Actions
#   Secrets  ：FINLAB_API_TOKEN、SITE_PASSWORD
#   Variables：SITE_SALT
